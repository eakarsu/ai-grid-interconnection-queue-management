// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model ClusterWindow {
  id        String   @id @default(cuid())
  name String
  iso String
  season String
  status String
  openDate DateTime?
  closeDate DateTime?
  applications Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
  siteControls SiteControl[]
  depositRecords DepositRecord[]
  clusterStudys ClusterStudy[]
  networkUpgrades NetworkUpgrade[]
  costAllocations CostAllocation[]
  milestones Milestone[]
  modificationRequests ModificationRequest[]
  giaControls GiaControl[]
  withdrawalScenarios WithdrawalScenario[]
  affectedSystemStudys AffectedSystemStudy[]
}

model Project {
  id        String   @id @default(cuid())
  name String
  developer String
  technology String
  capacityMw Float
  queuePosition String
  status String
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteControl {
  id        String   @id @default(cuid())
  projectRef String
  parcel String
  controlType String
  evidenceDate DateTime?
  status String
  acreage Float
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepositRecord {
  id        String   @id @default(cuid())
  projectRef String
  phase String
  amount Float
  status String
  dueDate DateTime?
  paidAt DateTime?
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClusterStudy {
  id        String   @id @default(cuid())
  name String
  phase String
  lead String
  status String
  kickOff DateTime?
  projectCount Int
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NetworkUpgrade {
  id        String   @id @default(cuid())
  name String
  kind String
  estimatedCost Float
  voltage String
  status String
  inServiceDate DateTime?
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CostAllocation {
  id        String   @id @default(cuid())
  projectRef String
  upgradeRef String
  allocatedCost Float
  sharePct Float
  method String
  status String
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id        String   @id @default(cuid())
  projectRef String
  kind String
  dueDate DateTime?
  metDate DateTime?
  status String
  consequence String?
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModificationRequest {
  id        String   @id @default(cuid())
  projectRef String
  kind String
  description String
  materiality String
  status String
  submittedAt DateTime?
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiaControl {
  id        String   @id @default(cuid())
  projectRef String
  draft String
  status String
  targetExecution DateTime?
  tenderedBy String?
  version String
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WithdrawalScenario {
  id        String   @id @default(cuid())
  projectRef String
  scenario String
  penaltyEstimate Float
  capitalAtRisk Float
  decision String
  modeledAt DateTime?
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffectedSystemStudy {
  id        String   @id @default(cuid())
  projectRef String
  neighborSystem String
  finding String
  status String
  requestedAt DateTime?
  studyCost Float
  windowId String?
  window ClusterWindow? @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}
